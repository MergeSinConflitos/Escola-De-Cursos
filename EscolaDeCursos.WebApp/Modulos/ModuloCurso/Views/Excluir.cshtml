@using EscolaDeCursos.WebApp.Modulos.ModuloCurso

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Curso";
}

@model ExcluirCursoViewModel


<div class="card shadow-sm">

    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">
            Excluir Curso
        </h5>
    </div>


    <div class="card-body">


        <div class="alert alert-warning">

            Tem certeza que deseja excluir este curso?

        </div>


        <dl class="row">

            <dt class="col-sm-3">
                Nome
            </dt>

            <dd class="col-sm-9">
                @Model.Nome
            </dd>



            <dt class="col-sm-3">
                Carga Horária
            </dt>

            <dd class="col-sm-9">
                @Model.CargaHoraria horas
            </dd>



            <dt class="col-sm-3">
                Categoria
            </dt>

            <dd class="col-sm-9">
                @Model.CategoriaNome
            </dd>



            <dt class="col-sm-3">
                Nível
            </dt>

            <dd class="col-sm-9">
                @Model.NivelDeDificuldadeNome
            </dd>

        </dl>



        <form asp-action="Excluir" method="post">

            <input type="hidden" asp-for="Id" />


            <div class="d-flex justify-content-between">


                <a asp-action="Listar" class="btn btn-outline-secondary">

                    Cancelar

                </a>


                <button type="submit" class="btn btn-danger">

                    Confirmar exclusão

                </button>


            </div>


        </form>


    </div>

</div>