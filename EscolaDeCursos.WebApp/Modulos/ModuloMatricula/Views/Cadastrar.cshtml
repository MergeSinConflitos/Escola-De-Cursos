@using EscolaDeCursos.WebApp.Modulos.ModuloMatricula
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Nova Matrícula";
}

@model CadastrarMatriculaViewModel

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;"
      asp-action="Cadastrar" method="post">

    <h4 class="text-primary mb-4">Nova Matrícula</h4>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            @foreach (var erro in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p class="mb-0">@erro.ErrorMessage</p>
            }
        </div>
    }

    <div class="mb-3">
        <label asp-for="AlunoId" class="form-label fw-semibold text-primary text-uppercase small">
            Aluno
        </label>
        <select asp-for="AlunoId" class="form-select">
            <option value="">Selecione um aluno...</option>
            @foreach (var aluno in Model.Alunos)
            {
                <option value="@aluno.Id">@aluno.Nome</option>
            }
        </select>
        <span asp-validation-for="AlunoId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TurmaId" class="form-label fw-semibold text-primary text-uppercase small">
            Turma
        </label>
        <select asp-for="TurmaId" class="form-select">
            <option value="">Selecione uma turma...</option>
            @foreach (var turma in Model.Turmas)
            {
                <option value="@turma.Id">@turma.Nome</option>
            }
        </select>
        <span asp-validation-for="TurmaId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DataInscricao" class="form-label fw-semibold text-primary text-uppercase small">
            Data de Inscrição
        </label>
        <input asp-for="DataInscricao" type="date" class="form-control"
               value="@Model.DataInscricao.ToString("yyyy-MM-dd")">
        <span asp-validation-for="DataInscricao" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Situacao" class="form-label fw-semibold text-primary text-uppercase small">
            Situação
        </label>
        <select asp-for="Situacao" class="form-select">
            <option value="">Selecione uma situação...</option>
            <option value="0">Ativa</option>
            <option value="1">Cancelada</option>
            <option value="2">Concluida</option>
        </select>
        <span asp-validation-for="Situacao" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-success rounded-pill px-4" type="submit">Confirmar</button>
    </div>

</form>