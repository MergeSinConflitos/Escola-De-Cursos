@using EscolaDeCursos.Dominio.Modulos.ModuloNivelDeDificuldade
@using EscolaDeCursos.WebApp.Modulos.ModuloNivelDeDificuldade
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastrar Nível de Dificuldade";
}

@model CadastrarNivelDeDificuldadeViewModel


<div class="card shadow-sm">

    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            Cadastrar Nível de Dificuldade
        </h5>
    </div>


    <div class="card-body">

        <form asp-action="Cadastrar" method="post">


            <div class="mb-3">

                <label asp-for="Nome" class="form-label">
                    Nome
                </label>


                <input asp-for="Nome" class="form-control" placeholder="Digite o nome do nível de dificuldade" />


                <span asp-validation-for="Nome" class="text-danger">
                </span>

            </div>




            <div class="mb-3">

                <label asp-for="Descricao" class="form-label">
                    Descrição
                </label>


                <textarea asp-for="Descricao" class="form-control" rows="4" placeholder="Digite uma descrição">
                </textarea>


                <span asp-validation-for="Descricao" class="text-danger">
                </span>

            </div>





            <div class="mb-3">

                <label asp-for="Classificacao" class="form-label">
                    Classificação
                </label>


                <select asp-for="Classificacao" class="form-select">


                    <option value="">
                        Selecione uma classificação
                    </option>


                    @foreach (Classificacao classificacao in Enum.GetValues<Classificacao>())
                    {
                        <option value="@classificacao">
                            @classificacao
                        </option>
                    }


                </select>


                <span asp-validation-for="Classificacao" class="text-danger">
                </span>


            </div>





            <div class="d-flex justify-content-between">


                <a class="btn btn-outline-secondary" asp-action="Listar">

                    Voltar

                </a>



                <button type="submit" class="btn btn-primary">

                    Salvar

                </button>


            </div>



        </form>


    </div>


</div>