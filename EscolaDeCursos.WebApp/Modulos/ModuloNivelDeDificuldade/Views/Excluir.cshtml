@using EscolaDeCursos.WebApp.Modulos.ModuloNivelDeDificuldade
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Nível de Dificuldade";
}

@model ExcluirNivelDeDificuldadeViewModel


<div class="card shadow-sm border-danger">


    <div class="card-header bg-danger text-white">

        <h5 class="mb-0">
            Excluir Nível de Dificuldade
        </h5>

    </div>



    <div class="card-body">


        <p class="fs-5">
            Tem certeza que deseja excluir este nível de dificuldade?
        </p>



        <div class="alert alert-warning">


            <p>
                <strong>Nome:</strong>
                @Model.Nome
            </p>


            <p>
                <strong>Descrição:</strong>
                @(string.IsNullOrWhiteSpace(Model.Descricao)
                    ? "Sem descrição"
                    : Model.Descricao)
            </p>


            <p>
                <strong>Classificação:</strong>

                <span class="badge bg-primary">
                    @Model.Classificacao
                </span>

            </p>


        </div>





        <form asp-action="Excluir" method="post">


            <input asp-for="Id" type="hidden" />



            <div class="d-flex justify-content-between">


                <a class="btn btn-outline-secondary" asp-action="Listar">

                    Cancelar

                </a>



                <button type="submit" class="btn btn-danger">

                    Confirmar Exclusão

                </button>


            </div>


        </form>



    </div>


</div>