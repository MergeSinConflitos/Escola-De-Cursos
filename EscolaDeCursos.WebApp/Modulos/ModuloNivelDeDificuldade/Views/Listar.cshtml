@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Níveis de Dificuldade";
}

@model List<ListarNivelDeDificuldadeViewModel>


<div class="d-flex justify-content-between align-items-center mb-4">

    <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Cadastrar">

        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1"
             viewBox="0 0 16 16">

            <path fill-rule="evenodd"
                  d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z" />

        </svg>

        Cadastrar Novo

    </a>

</div>


<!-- Barra de Pesquisa -->
<div class="card shadow-sm mb-4">

    <div class="card-body">

        <form asp-action="Listar" method="get">

            <div class="row g-3">

                <div class="col-md-6">

                    <label class="form-label">
                        Nome
                    </label>

                    <input type="text" name="pesquisa" value="@ViewBag.Pesquisa" class="form-control"
                           placeholder="Pesquisar pelo nome..." />

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Classificação
                    </label>

                    <select name="classificacao" class="form-select">

                        <option value="">
                            Todas as classificações
                        </option>


                        @foreach (Classificacao item in Enum.GetValues<Classificacao>())
                        {
                            <option value="@item" selected="@(ViewBag.Classificacao?.ToString() == item.ToString())">

                                @item

                            </option>
                        }

                    </select>

                </div>


                <div class="col-md-2 d-flex align-items-end">

                    <button class="btn btn-primary w-100" type="submit">

                        <i class="bi bi-search me-1"></i>
                        Pesquisar

                    </button>

                </div>

            </div>


            <div class="mt-3">

                <a asp-action="Listar" class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-clockwise me-1"></i>
                    Limpar

                </a>

            </div>


        </form>

    </div>

</div>


@if (TempData["MensagemErro"] is string erro)
{
    <div class="alert alert-danger">
        @erro
    </div>
}


@if (TempData["MensagemSucesso"] is string sucesso)
{
    <div class="alert alert-success">
        @sucesso
    </div>
}



@if (!Model.Any())
{
    <div class="alert alert-info">
        Nenhum nível de dificuldade encontrado.
    </div>
}
else
{

    <div class="row g-4">


        @foreach (var nivel in Model)
        {
            var idCurto = nivel.Id.ToString("N")[..7];


            <div class="col-md-6 col-lg-4">


                <div class="card h-100 shadow-sm">


                    <div class="card-header bg-primary text-white 
                        d-flex justify-content-between align-items-center">


                        <strong>
                            @nivel.Nome
                        </strong>


                        <span class="badge bg-light text-dark">
                            #@idCurto
                        </span>


                    </div>



                    <div class="card-body">


                        <p>
                            <strong>Descrição:</strong>
                        </p>


                        <p>
                            @(string.IsNullOrWhiteSpace(nivel.Descricao)
                                ? "Sem descrição."
                                : nivel.Descricao)
                        </p>



                        <p>

                            <strong>Classificação:</strong>


                            <span class="badge bg-success">

                                @nivel.Classificacao

                            </span>


                        </p>


                    </div>




                    <div class="card-footer bg-white">


                        <div class="d-grid gap-2">


                            <a class="btn btn-success" asp-action="Cursos" asp-route-id="@nivel.Id">

                                Cursos Associados

                            </a>



                            <div class="btn-group">


                                <a class="btn btn-primary" asp-action="Editar" asp-route-id="@nivel.Id">

                                    Editar

                                </a>



                                <a class="btn btn-outline-danger" asp-action="Excluir" asp-route-id="@nivel.Id">

                                    Excluir

                                </a>


                            </div>


                        </div>


                    </div>


                </div>


            </div>
        }


    </div>

}



<style>
    .card {
        transition: all .2s ease-in-out;
    }


    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .15);
    }
</style>