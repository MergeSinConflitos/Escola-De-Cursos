@using EscolaDeCursos.WebApp.Modulos.ModuloCategoria
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Categoria";
}

@model ExcluirCategoriaViewModel


<div class="card shadow-sm border-danger">


    <div class="card-header bg-danger text-white">

        <h5 class="mb-0">
            Excluir Categoria
        </h5>

    </div>



    <div class="card-body">


        <p class="fs-5">
            Tem certeza que deseja excluir esta categoria?
        </p>


        <div class="alert alert-warning">

            <strong>
                Categoria:
            </strong>

            @Model.Nome

        </div>



        <form asp-action="Excluir" method="post">

            <input asp-for="Id" type="hidden" />


            <div class="d-flex justify-content-between">


                <a class="btn btn-outline-secondary" asp-action="Listar">

                    Cancelar

                </a>



                <button type="submit" class="btn btn-danger">

                    Confirmar Exclusão

                </button>


            </div>


        </form>


    </div>


</div>