@using EscolaDeCursos.WebApp.Modulos.ModuloCategoria
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Categoria";
}

@model EditarCategoriaViewModel


<div class="card shadow-sm">

    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            Editar Categoria
        </h5>
    </div>


    <div class="card-body">

        <form asp-action="Editar" method="post">

            <input asp-for="Id" type="hidden" />


            <div class="mb-3">

                <label asp-for="Nome" class="form-label">
                    Nome
                </label>


                <input asp-for="Nome" class="form-control" placeholder="Digite o nome da categoria" />


                <span asp-validation-for="Nome" class="text-danger">
                </span>

            </div>



            <div class="d-flex justify-content-between">

                <a class="btn btn-outline-secondary" asp-action="Listar">

                    Voltar

                </a>


                <button type="submit" class="btn btn-primary">

                    Salvar Alterações

                </button>

            </div>


        </form>

    </div>

</div>