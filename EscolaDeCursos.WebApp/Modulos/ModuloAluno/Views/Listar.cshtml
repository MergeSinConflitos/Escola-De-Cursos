@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Alunos";
}

@model List<ListarAlunosViewModel>


<div class="d-flex justify-content-between align-items-center mb-4">

    <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Cadastrar">

        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1"
             viewBox="0 0 16 16">

            <path fill-rule="evenodd"
                  d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z" />

        </svg>

        Cadastrar Novo

    </a>

</div>



@if (TempData["MensagemErro"] is string erro)
{
    <div class="alert alert-danger">
        @erro
    </div>
}


@if (TempData["MensagemSucesso"] is string sucesso)
{
    <div class="alert alert-success">
        @sucesso
    </div>
}

<!-- Barra de Pesquisa -->
<div class="card shadow-sm mb-4">

    <div class="card-body">

        <form asp-action="Listar" method="get">

            <div class="row g-3 align-items-end">

                <div class="col-md-10">

                    <label class="form-label">
                        Pesquisar aluno
                    </label>

                    <input type="text" name="pesquisa" value="@ViewBag.Pesquisa" class="form-control"
                           placeholder="Digite o nome do aluno..." />

                </div>


                <div class="col-md-2">

                    <button class="btn btn-primary w-100" type="submit">

                        <i class="bi bi-search me-1"></i>
                        Pesquisar

                    </button>

                </div>

            </div>


            <div class="mt-3">

                <a asp-action="Listar" class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-clockwise me-1"></i>
                    Limpar

                </a>

            </div>

        </form>

    </div>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nenhum Aluno encontrado.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var aluno in Model)
        {
            var idCurto = aluno.Id.ToString("N")[..7];


            <div class="col-md-6 col-lg-4">

                <div class="card h-100 shadow-sm">


                    <div class="card-header bg-primary text-white 
                        d-flex justify-content-between align-items-center">

                        <strong>
                            @aluno.Nome
                        </strong>


                        <span class="badge bg-light text-dark">
                            #@idCurto
                        </span>

                    </div>



                    <div class="card-body">

                        <p>
                            <strong>Nome:</strong>
                            @aluno.Nome
                        </p>

                        <p>
                            <strong>Telefone:</strong>
                            @aluno.Telefone
                        </p>

                        <p>
                            <strong>Email:</strong>
                            @aluno.Email
                        </p>


                    </div>



                    <div class="card-footer bg-white">


                        <div class="btn-group w-100">


                            <a class="btn btn-primary" asp-action="Editar" asp-route-id="@aluno.Id">

                                Editar

                            </a>


                            <a class="btn btn-outline-danger" asp-action="Excluir" asp-route-id="@aluno.Id">

                                Excluir

                            </a>


                        </div>


                    </div>


                </div>

            </div>
        }

    </div>

}



<style>
    .card {
        transition: all .2s ease-in-out;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .15);
    }
</style>