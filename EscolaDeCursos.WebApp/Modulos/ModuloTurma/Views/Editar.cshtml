@using EscolaDeCursos.WebApp.Modulos.ModuloTurma
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Turma";
}

@model EditarTurmaViewModel

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">Editar Turma</h5>
    </div>

    <div class="card-body">
        <form asp-action="Editar" method="post">
            <!-- Campo oculto para el ID -->
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nome" class="form-label">Nome da Turma</label>
                <input asp-for="Nome" class="form-control" placeholder="Ex: Turma de C# Avançado - 2024" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Periodo" class="form-label">Período</label>
                <select asp-for="Periodo" class="form-select">
                    <option value="0">Selecione um período</option>
                    <option value="1">Manhã</option>
                    <option value="2">Tarde</option>
                    <option value="3">Noite</option>
                </select>
                <span asp-validation-for="Periodo" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DataInicio" class="form-label">Data de Início</label>
                    <input asp-for="DataInicio" type="date" class="form-control" />
                    <span asp-validation-for="DataInicio" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DataTermino" class="form-label">Data de Término</label>
                    <input asp-for="DataTermino" type="date" class="form-control" />
                    <span asp-validation-for="DataTermino" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="QuantidadeMaxAlunos" class="form-label">Quantidade Máxima de Alunos</label>
                <input asp-for="QuantidadeMaxAlunos" type="number" class="form-control" placeholder="Ex: 30" min="1" />
                <span asp-validation-for="QuantidadeMaxAlunos" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CursoId" class="form-label">Curso</label>
                    <select asp-for="CursoId" class="form-select">
                        <option value="">Selecione um curso</option>
                        @foreach (var curso in Model.Cursos)
                        {
                            <option value="@curso.Id" selected="@(curso.Id == Model.CursoId)">@curso.Nome</option>
                        }
                    </select>
                    <span asp-validation-for="CursoId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="InstrutorId" class="form-label">Instrutor</label>
                    <select asp-for="InstrutorId" class="form-select">
                        <option value="">Selecione um instrutor</option>
                        @foreach (var instrutor in Model.Instrutores)
                        {
                            <option value="@instrutor.Id" selected="@(instrutor.Id == Model.InstrutorId)">@instrutor.Nome</option>
                        }
                    </select>
                    <span asp-validation-for="InstrutorId" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Listar" class="btn btn-outline-secondary">Voltar</a>
                <button type="submit" class="btn btn-warning">Atualizar</button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}