@using EscolaDeCursos.WebApp.Modulos.ModuloTurma

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Turmas";
}

@model List<ListarTurmaViewModel>


<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="h3 mb-0">
        @ViewBag.Titulo
    </h1>


    <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Cadastrar">

        <i class="bi bi-plus-lg me-1"></i>

        Cadastrar Nova Turma

    </a>

</div>



@if (TempData["MensagemErro"] is string erro)
{
    <div class="alert alert-danger alert-dismissible fade show">

        @erro

        <button type="button" class="btn-close" data-bs-dismiss="alert">
        </button>

    </div>
}



@if (TempData["MensagemSucesso"] is string sucesso)
{
    <div class="alert alert-success alert-dismissible fade show">

        @sucesso

        <button type="button" class="btn-close" data-bs-dismiss="alert">
        </button>

    </div>
}




<!-- PESQUISA -->

<div class="card shadow-sm mb-4">

    <div class="card-body">


        <form asp-action="Listar" method="get">


            <div class="row g-3">


                <div class="col-md-3">

                    <label class="form-label">
                        Nome da Turma
                    </label>


                    <input type="text" name="nome" class="form-control" placeholder="Pesquisar turma..."
                           value="@Context.Request.Query["nome"]" />

                </div>




                <div class="col-md-3">

                    <label class="form-label">
                        Curso
                    </label>


                    <select name="curso" class="form-select">


                        <option value="">
                            Todos os cursos
                        </option>


                        @foreach (var curso in ViewBag.Cursos)
                        {
                            <option value="@curso.Nome" selected="@(Context.Request.Query["curso"] == curso.Nome)">

                                @curso.Nome

                            </option>
                        }


                    </select>

                </div>





                <div class="col-md-3">

                    <label class="form-label">
                        Instrutor
                    </label>


                    <select name="instrutor" class="form-select">


                        <option value="">
                            Todos os instrutores
                        </option>



                        @foreach (var instrutor in ViewBag.Instrutores)
                        {
                            <option value="@instrutor.Nome"
                                    selected="@(Context.Request.Query["instrutor"] == instrutor.Nome)">

                                @instrutor.Nome

                            </option>
                        }


                    </select>

                </div>





                <div class="col-md-3">

                    <label class="form-label">
                        Período
                    </label>


                    <select name="periodo" class="form-select">


                        <option value="">
                            Todos
                        </option>


                        <option value="Manha" selected="@(Context.Request.Query["periodo"] == "Manha")">

                            Matutino

                        </option>


                        <option value="Tarde" selected="@(Context.Request.Query["periodo"] == "Tarde")">

                            Vespertino

                        </option>


                        <option value="Noite" selected="@(Context.Request.Query["periodo"] == "Noite")">

                            Noturno

                        </option>


                    </select>

                </div>


            </div>




            <div class="mt-3">


                <button type="submit" class="btn btn-primary">

                    <i class="bi bi-search me-1"></i>

                    Pesquisar

                </button>




                <a asp-action="Listar" class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-clockwise me-1"></i>

                    Limpar

                </a>


            </div>



        </form>


    </div>

</div>





@if (!Model.Any())
{

    <div class="alert alert-info">

        <i class="bi bi-info-circle me-2"></i>

        Nenhuma turma encontrada.

    </div>

}

else
{


    <div class="row g-4">


        @foreach (var turma in Model)
        {


            var idCurto = turma.Id.ToString("N")[..7];

            var badgeClasse = turma.EstaCheia
                ? "bg-danger"
                : "bg-success";

            var estadoTexto = turma.EstaCheia
                ? "Cheia"
                : "Disponível";



            <div class="col-md-6 col-lg-4">


                <div class="card h-100 shadow-sm border-0">



                    <div class="card-header bg-primary text-white 
                        d-flex justify-content-between align-items-center">


                        <strong class="text-truncate">

                            @turma.Nome

                        </strong>



                        <span class="badge bg-light text-dark">

                            #@idCurto

                        </span>


                    </div>




                    <div class="card-body">



                        <div class="d-flex justify-content-between mb-3">


                            <span class="badge @badgeClasse">

                                @estadoTexto

                            </span>


                            <span class="text-muted small">

                                @turma.TotalAlunosMatriculados /
                                @turma.QuantidadeMaxAlunos alunos

                            </span>


                        </div>




                        <p>
                            <strong>
                                <i class="bi bi-calendar-event me-1"></i>
                                Período:
                            </strong>

                            @turma.Periodo

                        </p>



                        <p>

                            <strong>
                                <i class="bi bi-calendar-range me-1"></i>
                                Início:
                            </strong>

                            @turma.DataInicio.ToString("dd/MM/yyyy")

                        </p>




                        <p>

                            <strong>
                                <i class="bi bi-calendar-check me-1"></i>
                                Término:
                            </strong>

                            @turma.DataTermino.ToString("dd/MM/yyyy")

                        </p>



                        <hr />


                        <p class="mb-1 small">

                            <strong>
                                Curso:
                            </strong>

                            @turma.CursoNome

                        </p>



                        <p class="mb-0 small">

                            <strong>
                                Instrutor:
                            </strong>

                            @turma.InstrutorNome

                        </p>


                    </div>




                    <div class="card-footer bg-white border-0">


                        <div class="btn-group w-100">


                            <a class="btn btn-primary" asp-action="Editar" asp-route-id="@turma.Id">

                                Editar

                            </a>



                            <a class="btn btn-outline-danger" asp-action="Excluir" asp-route-id="@turma.Id">

                                Excluir

                            </a>


                        </div>


                    </div>


                </div>


            </div>


        }


    </div>


}





<style>
    .card {

        transition: all .2s ease-in-out;

        border-radius: .5rem;

    }


    .card:hover {

        transform: translateY(-5px);

        box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .15);

    }


    .text-truncate {

        white-space: nowrap;

        overflow: hidden;

        text-overflow: ellipsis;

    }
</style>