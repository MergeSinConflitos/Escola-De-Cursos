@using EscolaDeCursos.WebApp.Modulos.ModuloInstrutor
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Instrutor";
}

@model EditarInstrutorViewModel


<div class="card shadow-sm">

    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            Editar Instrutor
        </h5>
    </div>


    <div class="card-body">

        <form asp-action="Cadastrar" method="post">


            <div class="mb-3">

                <label asp-for="Nome" class="form-label">
                    Nome
                </label>


                <input asp-for="Nome" class="form-control" />


                <span asp-validation-for="Nome" class="text-danger">
                </span>

            </div>

            
            <div class="mb-3">

                <label asp-for="Telefone" class="form-label">
                    Telefone
                </label>


                <input asp-for="Telefone" class="form-control" />


                <span asp-validation-for="Telefone" class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Email" class="form-label">
                    E-mail
                </label>


                <input asp-for="Email" class="form-control"  />


                <span asp-validation-for="Email" class="text-danger">
                </span>

            </div>

             <div class="mb-3">

                <label asp-for="Cpf" class="form-label">
                    CPF
                </label>


                <input asp-for="Cpf" class="form-control"  />


                <span asp-validation-for="Cpf" class="text-danger">
                </span>

            </div>


            <div class="d-flex justify-content-between">

                <a class="btn btn-outline-secondary" asp-action="Listar">

                    Voltar

                </a>


                <button type="submit" class="btn btn-primary">

                    Salvar Alterações

                </button>

            </div>


        </form>

    </div>

</div>