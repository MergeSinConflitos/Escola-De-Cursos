@{
    Layout = "_Layout";
    ViewBag.Titulo = "Página Inicial";
}

<div class="row align-items-center">

    <div class="col-lg-7">

        <h1 class="display-5 fw-bold mb-3">
            <i class="bi bi-mortarboard-fill me-2"></i>
            Sistema de Gerenciamento Acadêmico
        </h1>

        <p class="lead text-secondary mb-4">
            Gerencie cursos, alunos, instrutores, turmas e matrículas em um único lugar.
            Tenha controle da estrutura acadêmica da escola de forma simples e organizada.
        </p>

        <div class="d-flex gap-2 flex-wrap">

            <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="Curso" asp-action="Listar">
                <i class="bi bi-book me-1"></i>
                Cursos
            </a>

            <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="Aluno" asp-action="Listar">
                <i class="bi bi-person-vcard me-1"></i>
                Alunos
            </a>

            <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="Turma" asp-action="Listar">
                <i class="bi bi-building me-1"></i>
                Turmas
            </a>

            <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="Matricula" asp-action="Listar">
                <i class="bi bi-clipboard-check me-1"></i>
                Matrículas
            </a>

            <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="Instrutor" asp-action="Listar">
                <i class="bi bi-person-workspace me-1"></i>
                Instrutores
            </a>

        </div>

    </div>


    <div class="col-lg-5 mt-4 mt-lg-0">

        <div class="card border-primary-subtle shadow-sm">

            <div class="card-body p-4">

                <h3 class="h5 text-primary mb-3">
                    <i class="bi bi-grid me-2"></i>
                    Módulos disponíveis
                </h3>


                <div class="list-group list-group-flush">


                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                       asp-controller="Curso" asp-action="Listar">

                        <span>
                            <i class="bi bi-book me-2"></i>
                            Cursos
                        </span>

                        <span class="badge text-bg-primary rounded-pill">
                            Abrir
                        </span>

                    </a>



                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                       asp-controller="Aluno" asp-action="Listar">

                        <span>
                            <i class="bi bi-person-vcard me-2"></i>
                            Alunos
                        </span>

                        <span class="badge text-bg-primary rounded-pill">
                            Abrir
                        </span>

                    </a>



                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                       asp-controller="Turma" asp-action="Listar">

                        <span>
                            <i class="bi bi-building me-2"></i>
                            Turmas
                        </span>

                        <span class="badge text-bg-primary rounded-pill">
                            Abrir
                        </span>

                    </a>



                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                       asp-controller="Matricula" asp-action="Listar">

                        <span>
                            <i class="bi bi-clipboard-check me-2"></i>
                            Matrículas
                        </span>

                        <span class="badge text-bg-primary rounded-pill">
                            Abrir
                        </span>

                    </a>



                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                       asp-controller="Instrutor" asp-action="Listar">

                        <span>
                            <i class="bi bi-person-workspace me-2"></i>
                            Instrutores
                        </span>

                        <span class="badge text-bg-primary rounded-pill">
                            Abrir
                        </span>

                    </a>



                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                       asp-controller="Categoria" asp-action="Listar">

                        <span>
                            <i class="bi bi-tags me-2"></i>
                            Categorias
                        </span>

                        <span class="badge text-bg-primary rounded-pill">
                            Abrir
                        </span>

                    </a>



                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                       asp-controller="NivelDificuldade" asp-action="Listar">

                        <span>
                            <i class="bi bi-bar-chart-steps me-2"></i>
                            Níveis de Dificuldade
                        </span>

                        <span class="badge text-bg-primary rounded-pill">
                            Abrir
                        </span>

                    </a>



                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                       asp-controller="Etapa" asp-action="Listar">

                        <span>
                            <i class="bi bi-journal-bookmark me-2"></i>
                            Módulos
                        </span>

                        <span class="badge text-bg-primary rounded-pill">
                            Abrir
                        </span>

                    </a>


                </div>

            </div>

        </div>

    </div>

</div>