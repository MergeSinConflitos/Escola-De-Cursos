@{
    Layout = "_Layout";
    ViewBag.Titulo = "Página Inicial";
}

<style>
    .hero {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        color: white;
        border-radius: 20px;
        padding: 3rem;
        margin-bottom: 2.5rem;
    }

    .hero i {
        font-size: 6rem;
        opacity: .15;
    }

    .modulo-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        transition: .35s ease;
        cursor: pointer;
        position: relative;
    }

    .modulo-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 1rem 2rem rgba(0, 0, 0, .18) !important;
    }

    .modulo-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: -120%;
        width: 70%;
        height: 100%;
        background: linear-gradient(120deg,
                transparent,
                rgba(255, 255, 255, .35),
                transparent);
        transition: .8s;
    }

    .modulo-card:hover::before {
        left: 150%;
    }

    .modulo-card i {
        font-size: 3.2rem;
        transition: .35s;
    }

    .modulo-card:hover i {
        transform: scale(1.15);
    }

    .modulo-card h5 {
        transition: .35s;
    }

    .modulo-card:hover h5 {
        color: #0d6efd;
    }

    .modulo-card p {
        font-size: .9rem;
    }
</style>

<div class="container py-5">

    <!-- Banner -->

    <div class="hero shadow">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <h1 class="display-5 fw-bold">

                    <i class="bi bi-mortarboard-fill me-2"></i>
                    Sistema de Gerenciamento Acadêmico

                </h1>

                <p class="lead mt-3 mb-0">

                    Centralize o gerenciamento de cursos, alunos, instrutores,
                    turmas, categorias, níveis, etapas e matrículas em um único sistema.

                </p>

            </div>

            <div class="col-lg-4 text-end d-none d-lg-block">

                <i class="bi bi-journal-check"></i>

            </div>

        </div>

    </div>

    <div class="mb-4">

        <h3 class="fw-bold">

            <i class="bi bi-grid-fill text-primary me-2"></i>
            Módulos do Sistema

        </h3>

        <p class="text-muted">
            Selecione um módulo para começar.
        </p>

    </div>

    <div class="row g-4">

        <!-- Cursos -->

        <div class="col-xl-3 col-lg-4 col-md-6">

            <a asp-controller="Curso" asp-action="Listar" class="text-decoration-none text-dark">

                <div class="card modulo-card shadow-sm h-100">

                    <div class="card-body text-center py-4">

                        <i class="bi bi-book text-primary"></i>

                        <h5 class="mt-3">
                            Cursos
                        </h5>

                        <p class="text-muted mb-0">
                            Cadastro e gerenciamento de cursos.
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- Alunos -->

        <div class="col-xl-3 col-lg-4 col-md-6">

            <a asp-controller="Aluno" asp-action="Listar" class="text-decoration-none text-dark">

                <div class="card modulo-card shadow-sm h-100">

                    <div class="card-body text-center py-4">

                        <i class="bi bi-person-vcard text-success"></i>

                        <h5 class="mt-3">
                            Alunos
                        </h5>

                        <p class="text-muted mb-0">
                            Cadastro e consulta de alunos.
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- Instrutores -->

        <div class="col-xl-3 col-lg-4 col-md-6">

            <a asp-controller="Instrutor" asp-action="Listar" class="text-decoration-none text-dark">

                <div class="card modulo-card shadow-sm h-100">

                    <div class="card-body text-center py-4">

                        <i class="bi bi-person-workspace text-info"></i>

                        <h5 class="mt-3">
                            Instrutores
                        </h5>

                        <p class="text-muted mb-0">
                            Gerenciamento dos instrutores.
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- Turmas -->

        <div class="col-xl-3 col-lg-4 col-md-6">

            <a asp-controller="Turma" asp-action="Listar" class="text-decoration-none text-dark">

                <div class="card modulo-card shadow-sm h-100">

                    <div class="card-body text-center py-4">

                        <i class="bi bi-building text-warning"></i>

                        <h5 class="mt-3">
                            Turmas
                        </h5>

                        <p class="text-muted mb-0">
                            Organização das turmas.
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- Matrículas -->

        <div class="col-xl-3 col-lg-4 col-md-6">

            <a asp-controller="Matricula" asp-action="Listar" class="text-decoration-none text-dark">

                <div class="card modulo-card shadow-sm h-100">

                    <div class="card-body text-center py-4">

                        <i class="bi bi-clipboard-check text-danger"></i>

                        <h5 class="mt-3">
                            Matrículas
                        </h5>

                        <p class="text-muted mb-0">
                            Controle das matrículas.
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- Categorias -->

        <div class="col-xl-3 col-lg-4 col-md-6">

            <a asp-controller="Categoria" asp-action="Listar" class="text-decoration-none text-dark">

                <div class="card modulo-card shadow-sm h-100">

                    <div class="card-body text-center py-4">

                        <i class="bi bi-tags text-secondary"></i>

                        <h5 class="mt-3">
                            Categorias
                        </h5>

                        <p class="text-muted mb-0">
                            Categorias dos cursos.
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- Níveis -->

        <div class="col-xl-3 col-lg-4 col-md-6">

            <a asp-controller="NivelDeDificuldade" asp-action="Listar" class="text-decoration-none text-dark">

                <div class="card modulo-card shadow-sm h-100">

                    <div class="card-body text-center py-4">

                        <i class="bi bi-bar-chart-steps text-dark"></i>

                        <h5 class="mt-3">
                            Níveis
                        </h5>

                        <p class="text-muted mb-0">
                            Níveis de dificuldade.
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- Etapas -->

        <div class="col-xl-3 col-lg-4 col-md-6">

            <a asp-controller="Etapa" asp-action="Listar" class="text-decoration-none text-dark">

                <div class="card modulo-card shadow-sm h-100">

                    <div class="card-body text-center py-4">

                        <i class="bi bi-journal-bookmark text-primary"></i>

                        <h5 class="mt-3">
                            Etapas
                        </h5>

                        <p class="text-muted mb-0">
                            Organização dos módulos do curso.
                        </p>

                    </div>

                </div>

            </a>

        </div>

    </div>

</div>