<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    @* Importação do CSS do Bootstrap *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <title>@ViewBag.Titulo - Escola de Cursos</title>
</head>

<body>
    @* Barra de Navegação *@
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

    <div class="container">

        <!-- Logo -->

        <a class="navbar-brand fw-semibold"
           asp-controller="Home"
           asp-action="Index">

            <i class="bi bi-mortarboard-fill text-warning me-2"></i>

            Escola de Cursos

        </a>


        <!-- Botão Mobile -->

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menuPrincipal">

            <span class="navbar-toggler-icon"></span>

        </button>



        <div class="collapse navbar-collapse"
             id="menuPrincipal">


            @if (User.Identity?.IsAuthenticated == true)
            {


                <!-- Menu Principal -->

                <ul class="navbar-nav me-auto">


                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-house-door me-1"></i>

                            Início

                        </a>

                    </li>



                    <li class="nav-item dropdown">


                        <a class="nav-link dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">

                            <i class="bi bi-grid me-1"></i>

                            Módulos

                        </a>



                        <ul class="dropdown-menu shadow">


                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Categoria"
                                   asp-action="Listar">

                                    <i class="bi bi-tags me-2"></i>
                                    Categorias

                                </a>
                            </li>



                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Curso"
                                   asp-action="Listar">

                                    <i class="bi bi-book me-2"></i>
                                    Cursos

                                </a>
                            </li>



                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Instrutor"
                                   asp-action="Listar">

                                    <i class="bi bi-person-workspace me-2"></i>
                                    Instrutores

                                </a>
                            </li>



                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Aluno"
                                   asp-action="Listar">

                                    <i class="bi bi-person-vcard me-2"></i>
                                    Alunos

                                </a>
                            </li>



                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Turma"
                                   asp-action="Listar">

                                    <i class="bi bi-building me-2"></i>
                                    Turmas

                                </a>
                            </li>



                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Matricula"
                                   asp-action="Listar">

                                    <i class="bi bi-clipboard-check me-2"></i>
                                    Matrículas

                                </a>
                            </li>



                            <li>
                                <a class="dropdown-item"
                                   asp-controller="NivelDeDificuldade"
                                   asp-action="Listar">

                                    <i class="bi bi-bar-chart-steps me-2"></i>
                                    Níveis

                                </a>
                            </li>



                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Etapa"
                                   asp-action="Listar">

                                    <i class="bi bi-journal-bookmark me-2"></i>
                                    Etapas

                                </a>
                            </li>


                        </ul>


                    </li>


                </ul>




                <!-- Usuário -->


                <div class="dropdown">


                    <button class="btn btn-outline-light rounded-pill btn-sm dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown">


                        <i class="bi bi-person-circle me-1"></i>


                        @User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value


                    </button>



                    <ul class="dropdown-menu dropdown-menu-end shadow">


                        <li>


                            <h6 class="dropdown-header">

                                <i class="bi bi-person me-2"></i>

                                Conta

                            </h6>


                        </li>



                        <li>


                            <form asp-controller="Autenticacao"
                                  asp-action="Sair"
                                  method="post">


                                <button type="submit"
                                        class="dropdown-item text-danger">


                                    <i class="bi bi-box-arrow-right me-2"></i>

                                    Sair


                                </button>


                            </form>


                        </li>


                    </ul>


                </div>


            }


        </div>


    </div>


</nav>
    @* Cabeçalho da Página *@
    <header class="container py-4">
        <h2>@ViewBag.Titulo</h2>
    </header>

    @* Conteúdo da Página *@
    <main class="container pb-5">
        @RenderBody()
    </main>

    @* Importação do JavaScript do Bootstrap *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>

    
</body>

</html>
